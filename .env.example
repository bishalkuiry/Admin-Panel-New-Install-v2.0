APP_NAME="InAllCart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=quixko_db
DB_USERNAME=quixko
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

SOFTWARE_VERSION=1.0

# Only needed when running a second instance of this stack on the same host
# (set a unique value per instance to avoid image/port/container clashes)
IMAGE_NAME=inallcart-app
APP_PORT=8000
DB_FORWARD_PORT=3307

